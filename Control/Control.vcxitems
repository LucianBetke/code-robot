<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{bba5d27b-f2ed-4325-8912-9a6b419b875e}</ItemsProjectGuid>
    <ItemsProjectName>Control</ItemsProjectName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(MSBuildThisFileDirectory)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectCapability Include="SourceItemsFromImports" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)src\PIRegler.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)src\Rad.h" />
    <ClInclude Include="$(MSBuildThisFileDirectory)src\SpeedWeg.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)src\PIRegler.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)src\Rad.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)src\SpeedWeg.cpp" />
  </ItemGroup>
</Project>